#!/usr/bin/env python3
"""Run Claude Code as an AgentForge agent.

AgentForge starts this bridge inside the task's verified worktree with a cleared environment and
writes an `agentforge-task-prompt-v1` document to stdin. The bridge:

1. decodes the prompt strictly (malformed input exits 2 before any agent runs);
2. turns it into natural-language instructions and runs `claude -p` headless in the worktree;
3. checks every changed path against the task's allowed and forbidden paths;
4. commits the changes, so the repository's own pre-commit hook and gate run on them.

Steps 1, 3, and 4 are shared with every other bridge through `scripts/agents/bridge_kit.py`
(ADR-0058). This file holds only what is Claude-specific: the instructions, the command line, the
tool policy, the `mcp.json` shape, and the co-author trailer.

Exit codes: 0 committed, 2 invalid input or configuration, 3 no changes, 4 path violation,
5 commit or pre-commit gate failure; any other code is Claude Code's own exit status.

For a task that holds the `use_mcp_tools` capability, the bridge also gives Claude Code the
AgentForge MCP task-tool gateway (`forge mcp serve`, P3-M005): task_contract, check_changes, and
run_gate, each checked against the task's capabilities and recorded in the project's audit log.

Options:
  --claude PATH   Claude Code executable (default: `claude` on PATH)
  --forge PATH    forge executable for the MCP gateway (default: `forge` on PATH; required, by
                  either route, for tasks with use_mcp_tools)
  --model NAME    model to request (default: Claude Code's configured default)
  --dry-run       print the instructions and command, run nothing
  --self-test     check the Claude-specific policy and the shared prompt fixture, then exit
"""

import argparse
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import bridge_kit

BRIDGE_PATH = "scripts/agents/claude-code-bridge"
AGENT_NAME = "Claude Code"
CO_AUTHOR = "Claude <noreply@anthropic.com>"

ALLOWED_TOOLS = [
    "Read",
    "Edit",
    "Write",
    "Glob",
    "Grep",
    "Bash(cargo *)",
    "Bash(./scripts/gate.sh *)",
    "Bash(./scripts/check-text-files)",
    "Bash(git status *)",
    "Bash(git diff *)",
    "Bash(git log *)",
    "Bash(ls *)",
]
DISALLOWED_TOOLS = [
    "Bash(git commit *)",
    "Bash(git push *)",
    "Bash(git reset *)",
    "Bash(git checkout *)",
    "Bash(git clean *)",
    "WebFetch",
    "WebSearch",
]


def script_tools(task):
    """Tools that let a task holding run_local_commands execute files in its own allowed paths,
    such as the self-tests it writes (P2-M035, finding 22). This grants nothing new: with
    run_local_commands the agent already runs arbitrary code through cargo. Which paths are
    runnable is decided by the kit; how to express that is Claude's business."""
    tools = []
    for path in bridge_kit.runnable_paths(task):
        tools += [f"Bash(./{path})", f"Bash(./{path} *)", f"Bash(python3 {path} *)", f"Bash(bash {path} *)"]
    return tools


def mcp_arguments(task, forge, scratch, worktree, root):
    """Claude Code arguments and allowed tools for the MCP gateway, or none for tasks without
    use_mcp_tools. `scratch` must already hold the contract as `contract.txt`."""
    serve = bridge_kit.mcp_server_arguments(
        task, forge, Path(scratch) / "contract.txt", worktree, root
    )
    if serve is None:
        return [], []
    config = Path(scratch) / "mcp.json"
    config.write_text(
        json.dumps({"mcpServers": {"agentforge": {"type": "stdio", "command": str(forge), "args": serve}}}, indent=2),
        encoding="utf-8",
    )
    return ["--mcp-config", str(config), "--strict-mcp-config"], ["mcp__agentforge"]


def instructions(task, message_file, mcp=False, scripts=False):
    return f"""You are the implementer for AgentForge task {task['task_id']} (milestone {task['milestone_id']}, role {task['primary_role']}).
You are running headless inside this task's isolated Git worktree. The current directory is the repository root.

## Goal
{task['goal']}

## Non-goals
{bridge_kit.bullets(task['non_goals'])}

## You may change only these paths
{bridge_kit.bullets(task['allowed_paths'], 'no paths are writable')}

## Never change these paths
{bridge_kit.bullets(task['forbidden_paths'])}

## Expected outputs
{bridge_kit.bullets(task['expected_outputs'])}

## Evidence requirements
{bridge_kit.bullets(task['evidence_requirements'])}

## Required gates
{bridge_kit.bullets(task['required_gates'])}

## How to work
1. Read AGENTS.md, PROJECT_STATE.md, and the active plan named in .plans/ACTIVE (if present) before
   changing anything, and follow the repository's conventions, its plan boundary, and its
   documentation style.
2. Change only the allowed paths above. Any change outside them makes the whole run fail, and
   nothing is committed.
3. Add or update tests for the behavior you change.
4. Run `./scripts/gate.sh full` and fix every failure it reports. Never weaken tests, lints, or
   checks to make them pass.
5. Do not commit, push, reset, or check out branches. The bridge commits your work after verifying
   the path boundary, and the repository's pre-commit hook re-runs the gate on that commit.
6. When you are done, write a detailed commit message to {message_file}: a conventional-commit
   subject line (for example `feat(scope): ...`), a blank line, then a body that explains what
   changed, why, and the evidence (tests added, gate results). Do not include Co-Authored-By
   trailers.
7. Finish with a short plain-text summary of what you changed and how you verified it.
""" + ("""- You may run files inside your allowed paths directly (for example `./scripts/x --self-test`, or
  `python3 scripts/x`), so run the tests you write for scripts, not only cargo tests.
""" if scripts else "") + ("""8. You have AgentForge's task tools (the `agentforge` MCP server): `task_contract` shows exactly
   what this task may change, `check_changes` judges your current changes against it, and
   `run_gate` runs one of the task's required gates. Call `check_changes` before you finish and fix
   anything it reports outside the task's scope. Every call is recorded.
""" if mcp else "")


def self_test():
    # The shared fixture pins this decoder to the Rust encoder (ADR-0058); the kit asserts the
    # same bytes from the other side.
    task = bridge_kit.decode_prompt(bridge_kit.FIXTURE.read_bytes())
    assert task["task_id"] == "P6-M004-T0001"

    sample = {
        "contract_version": "1",
        "task_id": "P9-M001-T0001",
        "milestone_id": "P9-M001",
        "primary_role": "implementer",
        "goal": "Multi-line goal\nwith ünïcode ✓",
        "non_goals": ["no scope creep"],
        "dependency_task_ids": [],
        "allowed_paths": ["crates/example", "docs/EXAMPLE.md"],
        "forbidden_paths": ["crates/example/secret"],
        "capabilities": ["run_local_commands", "write_owned_paths"],
        "required_approvals": [],
        "required_gates": ["full"],
        "expected_outputs": ["tests", "docs"],
        "evidence_requirements": [],
    }
    assert "P9-M001-T0001" in instructions(sample, Path("/tmp/msg"))
    assert "check_changes" not in instructions(sample, Path("/tmp/msg"))

    # Finding 22: a run_local_commands task may run files in its own allowed paths, and only those.
    scripted = dict(
        sample, allowed_paths=["scripts/tool", "./docs/X.md", "has space/x", "crates/example/", ".github/ci.yml"]
    )
    tools = script_tools(scripted)
    assert "Bash(./scripts/tool *)" in tools and "Bash(python3 scripts/tool *)" in tools, tools
    assert "Bash(./scripts/tool)" in tools and "Bash(bash scripts/tool *)" in tools, tools
    assert "Bash(./docs/X.md *)" in tools and "Bash(./crates/example *)" in tools, tools
    assert "Bash(./.github/ci.yml *)" in tools, "a leading dot is part of the path: " + str(tools)
    assert not any("has space" in tool for tool in tools), tools
    assert not any("secret" in tool or "README" in tool for tool in tools), tools
    assert script_tools(dict(scripted, capabilities=["write_owned_paths"])) == [], "needs run_local_commands"
    assert "run files inside your allowed paths" in instructions(scripted, Path("/tmp/msg"), scripts=True)
    assert "run files inside your allowed paths" not in instructions(scripted, Path("/tmp/msg"))
    assert "check_changes" in instructions(sample, Path("/tmp/msg"), mcp=True)

    with tempfile.TemporaryDirectory() as scratch:
        assert mcp_arguments(sample, None, scratch, "/wt", None) == ([], []), "no use_mcp_tools, no gateway"
        gated = dict(sample, capabilities=sample["capabilities"] + ["use_mcp_tools"])
        try:
            mcp_arguments(gated, None, scratch, "/wt", None)
            raise AssertionError("use_mcp_tools without forge must refuse")
        except bridge_kit.BridgeError:
            pass
        args, tools = mcp_arguments(gated, "/bin/forge", scratch, "/wt", "/project")
        assert args[0] == "--mcp-config" and args[2] == "--strict-mcp-config" and tools == ["mcp__agentforge"]
        server = json.loads(Path(args[1]).read_text())["mcpServers"]["agentforge"]
        assert server["command"] == "/bin/forge"
        assert server["args"] == [
            "mcp", "serve", "--contract", str(Path(scratch) / "contract.txt"),
            "--worktree", "/wt", "--root", "/project",
        ], server["args"]
        args, _ = mcp_arguments(gated, "/bin/forge", scratch, "/wt", None)
        assert "--root" not in json.loads(Path(args[1]).read_text())["mcpServers"]["agentforge"]["args"]

    print("claude-code-bridge self-test passed")
    return bridge_kit.EXIT_COMMITTED


def main():
    parser = argparse.ArgumentParser(add_help=True, description="Run Claude Code as an AgentForge agent.")
    parser.add_argument("--claude", default="claude")
    parser.add_argument("--forge")
    parser.add_argument("--model")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    arguments = parser.parse_args()
    if arguments.self_test:
        return self_test()

    try:
        raw_prompt = sys.stdin.buffer.read()
        task = bridge_kit.decode_prompt(raw_prompt)
    except (bridge_kit.PromptError, UnicodeDecodeError) as error:
        print(f"claude-code-bridge: invalid task prompt: {error}", file=sys.stderr)
        return bridge_kit.EXIT_INVALID
    if not task["allowed_paths"]:
        print("claude-code-bridge: the task declares no allowed paths", file=sys.stderr)
        return bridge_kit.EXIT_INVALID

    with tempfile.TemporaryDirectory(prefix="agentforge-bridge-") as scratch:
        message_file = Path(scratch) / "COMMIT_MSG"
        (Path(scratch) / "contract.txt").write_bytes(raw_prompt)
        try:
            mcp_args, mcp_tools = mcp_arguments(
                task, arguments.forge or shutil.which("forge"), scratch, Path.cwd(), bridge_kit.project_root()
            )
        except bridge_kit.BridgeError as error:
            print(f"claude-code-bridge: {error}", file=sys.stderr)
            return bridge_kit.EXIT_INVALID
        command = [
            arguments.claude,
            "-p",
            instructions(task, message_file, mcp=bool(mcp_args), scripts=bool(script_tools(task))),
            *mcp_args,
            "--permission-mode",
            "acceptEdits",
            "--allowedTools",
            *ALLOWED_TOOLS,
            *script_tools(task),
            *mcp_tools,
            "--disallowedTools",
            *DISALLOWED_TOOLS,
            "--add-dir",
            scratch,
            "--no-session-persistence",
            "--output-format",
            "text",
        ]
        if arguments.model:
            command += ["--model", arguments.model]
        if arguments.dry_run:
            print(command[2])
            print("command:", " ".join(part if part != command[2] else "<instructions>" for part in command))
            return bridge_kit.EXIT_COMMITTED

        print(f"claude-code-bridge: running Claude Code for {task['task_id']}", flush=True)
        agent = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            env=bridge_kit.agent_environment("claude-code-bridge"),
        )
        sys.stdout.write(agent.stdout)
        sys.stderr.write(agent.stderr)
        if agent.returncode != 0:
            print(f"claude-code-bridge: Claude Code exited {agent.returncode}; nothing committed", file=sys.stderr)
            return agent.returncode

        paths = bridge_kit.changed_paths()
        if not paths:
            print("claude-code-bridge: the agent made no changes", file=sys.stderr)
            return bridge_kit.EXIT_NO_CHANGES
        violations = bridge_kit.boundary_violations(paths, task["allowed_paths"], task["forbidden_paths"])
        if violations:
            print("claude-code-bridge: changes outside the task boundary; nothing committed:", file=sys.stderr)
            for path in violations:
                print(f"  {path}", file=sys.stderr)
            return bridge_kit.EXIT_PATH_VIOLATION
        print(f"claude-code-bridge: committing {len(paths)} changed path(s); the pre-commit gate runs now", flush=True)
        if (
            bridge_kit.commit(
                task,
                paths,
                message_file,
                agent.stdout,
                AGENT_NAME,
                BRIDGE_PATH,
                arguments.model,
                CO_AUTHOR,
            )
            != 0
        ):
            print("claude-code-bridge: commit or pre-commit gate failed; nothing committed", file=sys.stderr)
            return bridge_kit.EXIT_COMMIT_FAILED
    print("claude-code-bridge: committed")
    return bridge_kit.EXIT_COMMITTED


if __name__ == "__main__":
    sys.exit(main())
